# Required. At least 12 characters. Anyone with this can send as your WhatsApp number.
APP_PASSWORD=change-me-to-a-long-passphrase

# Your WhatsApp number with country code, digits only (e.g. 12125551234 for US +1 212 555 1234).
# When set, the server uses pairing-code auth instead of QR — more reliable on cloud hosts.
PHONE_NUMBER=

# Optional
PORT=3000
AUTH_DIR=./auth
MAX_PER_MINUTE=6
MAX_PER_DAY=100
# Set to 1 when running behind a proxy/host that terminates HTTPS (Railway, Render, Fly, nginx)
TRUST_PROXY=0
LOG_LEVEL=info
